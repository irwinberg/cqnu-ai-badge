[Unit]
Description=CQNU AI badge sync + message hub
After=network-online.target
[Service]
User=ubuntu
WorkingDirectory=/opt/cqnu/server
Environment=PATH=/home/ubuntu/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 /opt/cqnu/server/badge_server.py
Restart=always
RestartSec=3
[Install]
WantedBy=multi-user.target
